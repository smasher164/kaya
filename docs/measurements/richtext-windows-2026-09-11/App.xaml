<!-- THE APP'S ONE PIECE OF MARKUP: a WinUI 3 app with no XAML at all gets no
     generated IXamlMetadataProvider, the framework's deferred theme
     dictionaries cannot be parsed and the window dies on Activate (measured
     on this VM 2026-09-06, tools/win/searchprobe/App.xaml). A RichEditBox
     needs its template out of XamlControlsResources. -->
<Application
    x:Class="KayaRichProbe.ProbeApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
