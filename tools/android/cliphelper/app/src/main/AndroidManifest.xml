<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="KayaClipHelper">
        <provider
            android:name=".HelperProvider"
            android:authorities="dev.kaya.cliphelper"
            android:exported="false"
            android:grantUriPermissions="true"/>
        <receiver android:name=".SeedReceiver" android:exported="true">
            <intent-filter>
                <action android:name="dev.kaya.cliphelper.SEED"/>
            </intent-filter>
        </receiver>
        <receiver android:name=".ReadReceiver" android:exported="true">
            <intent-filter>
                <action android:name="dev.kaya.cliphelper.READ"/>
            </intent-filter>
        </receiver>
        <service
            android:name=".HelperIme"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method"/>
        </service>
    </application>
</manifest>
