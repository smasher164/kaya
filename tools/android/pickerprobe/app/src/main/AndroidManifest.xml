<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- NO STORAGE PERMISSIONS, deliberately. The first round declared
         MANAGE_EXTERNAL_STORAGE and READ_EXTERNAL_STORAGE and measured
         the shared-storage writes succeeding; neither was granted
         (isExternalStorageManager was false), but a probe whose manifest
         differs from the app's is measuring a different app. This round
         is the validation app's exact configuration. -->

    <application
        android:label="kaya picker probe"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".ProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".ProbeA11y"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/probe_accessibility" />
        </service>
    </application>
</manifest>
