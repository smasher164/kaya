<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 half of the drag probe (docs/dnd-plan.md §2 probes 1 and
       2). Unpackaged, because the lane's guests are unpackaged: the
       Windows App Runtime is already installed on the VM by
       tools/deploy-win.py, so WindowsPackageType=None plus the
       bootstrapper is the shape kaya's own backend runs in. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KayaDragProbe</RootNamespace>
    <AssemblyName>KayaDragProbe</AssemblyName>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\shared\Ole.cs" Link="Ole.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>
</Project>
