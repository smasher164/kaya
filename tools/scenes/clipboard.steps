# DESIGN.md, Clipboard. EVERY ASSERTION CROSSES A PROCESS BOUNDARY,
# because the LOWERINGS are the hard part (CF_HTML's offset header,
# Android's content:// URI, CF_HDROP's struct) and kaya reading what
# kaya wrote parses its own malformed header happily. The files are the
# guest's own, at <scene root>/kaya-clip-<pid>/, so guest and
# interpreter agree on the path with no runner involvement.
expect label#0 "ready"

# ---- copying: four representations, one clip ----------------------
click button#0
expect label#0 "copied"
expect_clipboard text "kaya clip"
expect_clipboard html "<b>kaya</b> clip"
expect_clipboard dev.kaya/note "note=1"

# THE IMAGE IS A DECODED SIZE, never a byte count: hosts re-encode
# freely (macOS synthesizes tiff, jpeg, gif and more from one png), so
# bytes would differ per lane for the same picture.
expect_clipboard image "4x4"

# ---- the custom format, read back ---------------------------------
#
# THE ONE THING NO FOREIGN PROCESS CAN SEED: no stock tool writes an
# app-defined type, and a helper kaya wrote would be foreign in name
# only. The foreign read above already confirmed the bytes are on the
# clipboard under that id.
click button#1
expect label#0 "custom dev.kaya/note note=1"

# ---- reading what another app put there ---------------------------
clipboard_seed text "from another app"
click button#2
expect label#0 "text from another app"

# THE READ IS FILTERED BY WHAT IT ACCEPTS: only text is on the board and
# this read accepts only files, so the answer is EMPTY — the same answer
# a denied prompt or an unfocused reader gives, which no platform tells
# apart.
click button#4
expect label#0 "empty"

# ---- an image, in and straight back out ---------------------------
#
# The guest copies the seeded picture back so a foreign DECODER can say
# what it is: a backend that mangled either leg fails here rather than
# on a byte count nobody can compare across platforms.
clipboard_seed image "$TMP/kaya-clip-$PID/pixel.png"
click button#3
expect label#0 "image"
expect_clipboard image "4x4"

# ---- a pasted file, opened for real -------------------------------
#
# A file on the clipboard is the SAME capability the picker returns, so
# the guest redeems the handle off the app thread (`open` blocks) and
# this fails unless a real descriptor carried the real file.
clipboard_seed files "$TMP/kaya-clip-$PID/pasted.txt"
click button#4
expect label#0 "files pasted.txt pasted bytes"

# ---- the gesture layer: Paste as a standard command ---------------
#
# A gesture is its own authorisation, so no platform charges a
# permission prompt for it. The privileged read above is the expensive
# door; this is the free one.
clipboard_seed text "pasted by hand"

# A widget that DECLARED what it accepts takes the content itself, so
# entry#0 staying empty is the proof kaya delivered the content INSTEAD
# of letting the platform insert it.
click button#5
expect_focused entry#0
menu_activate "Edit>Paste"
expect label#0 "pasted pasted by hand"
expect entry#0 ""

# A widget that declared NOTHING gets the platform's own insertion, and
# its ordinary change path reports the result.
click button#6
expect_focused entry#1
menu_activate "Edit>Paste"
expect entry#1 "pasted by hand"

# AND IT WENT WHERE IT WAS AIMED: entry#0 was focused a moment ago and
# is an editable field too, so a paste dispatched while the platform's
# focus is still catching up with kaya's lands THERE (measured
# 2026-08-04, twice in one mac lane run). Every other assertion here
# reads the same either way, so this line is what tells "the paste
# reached nobody" from "the paste reached the wrong widget".
expect entry#0 ""

# One REAL-TREE read at the end: everything above reads kaya's own model
# or the clipboard, and would pass for an arm that drew nothing.
expect_ax entry#1 "field/pasted by hand"

# ---- a STAMPED paste target ---------------------------------------
# The two-door contract on a COPY whose accept list came from the
# TEMPLATE (docs/tpl-props-plan.md P1); label#1 carries the copy's OWN
# KEY, the proof the paste arrived as an INSTANCE occurrence. `click
# entry#2` is the only scene click on a non-button: a stamped copy
# cannot be focused programmatically, and Stage::click is native on ANY
# target by contract.
click entry#2
expect_focused entry#2
menu_activate "Edit>Paste"
expect label#1 "row r1 pasted pasted by hand"
expect entry#2 ""
