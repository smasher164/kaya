# docs/styling-plan.md D4. `heading` is the one role with a real-tree
# observable on every platform; `destructive` and `prominent` are
# DECLARED here so every backend's arm runs, but their look has no
# AX-visible marker on SwiftUI and is held by lowering-side gates and
# captures instead. expect_inset is RELATIVE because an absolute offer
# cannot be byte-frozen across platforms — GTK's CSD headerbar sits
# inside the window's height where macOS's titlebar sits outside it.
expect label#0 "Sections"
expect_ax label#0 "heading/Sections"
expect_inset 0
expect label#1 "ready"
# The caption role's presence proof: its LOOK has no universal AX
# observable (GTK alone has a caption role), so the walls are each
# backend arm's refusal of an unarmed role, and this text.
expect label#2 "captioned"
expect_ax button#0 "button/Delete"
expect_ax button#1 "button/Save"
click button#0
expect label#1 "deleted"
click button#1
expect label#1 "saved"
