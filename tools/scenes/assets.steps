# docs/assets-plan.md. An IMAGE, because iOS depth-stubs
# `expect_typeface` and iOS is the lane whose asset delivery IS the
# shipped packaging mechanism. THE PICTURE IS SCENERY (the images/
# family, whose README says why): the DECLARED mark is a user-supplied
# source of any size and an image widget's intrinsic size drives layout,
# so this scene reports the mark's bytes as PRESENT and shows the small
# one. THE MISS SENTENCE names what the package
# CARRIES, so it passes only on a lane that staged the WHOLE root
# (tools/check-assets.py holds it equal to that root's listing), and its
# quoted `;` is the wall holding the three statement splitters equal.
expect_title "assets"
expect label#0 "assets"
expect image#0 "2x2"
expect label#1 "kaya: no asset named "icons/nope.png"; the package carries avatars/README.md, avatars/alex.jpg, avatars/maya.jpg, avatars/sam.jpg, catalogue/ATTRIBUTION.md, catalogue/README.md, catalogue/album-116452-300.jpg, catalogue/album-116452-600.jpg, catalogue/album-139585-300.jpg, catalogue/album-139585-600.jpg, catalogue/album-149020-300.jpg, catalogue/album-149020-600.jpg, catalogue/album-154466-300.jpg, catalogue/album-154466-600.jpg, catalogue/album-201715-300.jpg, catalogue/album-201715-600.jpg, catalogue/album-581719-300.jpg, catalogue/album-581719-600.jpg, catalogue/api.json, catalogue/t1161932.mp3, catalogue/t1161940.mp3, catalogue/t1243461.mp3, catalogue/t1243462.mp3, catalogue/t1296792.mp3, catalogue/t1296804.mp3, catalogue/t1860160.mp3, catalogue/t1860165.mp3, catalogue/t2207896.mp3, catalogue/t2207899.mp3, catalogue/t989871.mp3, catalogue/t989873.mp3, covers/README.md, covers/cover-1000.jpg, covers/cover-320.jpg, covers/cover-600.jpg, fonts/OFL.txt, fonts/README.md, fonts/sora-wght.ttf, icons/README.md, icons/kaya-mark.png, identities/README.md, identities/music.toml, identity.toml, images/README.md, images/a11y-logo.png, images/photo.jpg, l10n/README.md, l10n/format.ar.ftl, l10n/format.de.ftl, l10n/format.en.ftl, l10n/music.en.ftl, l10n/tasks.ar.ftl, l10n/tasks.en.ftl, market/README.md, market/prices.csv, market/transactions.csv, media/README.md, media/av1_aac.mp4, media/av1_opus.webm, media/captions.vtt, media/dash.mpd, media/dash_chunk_0_00001.m4s, media/dash_chunk_0_00002.m4s, media/dash_chunk_1_00001.m4s, media/dash_chunk_1_00002.m4s, media/dash_chunk_1_00003.m4s, media/dash_chunk_2_00001.m4s, media/dash_chunk_2_00002.m4s, media/dash_chunk_2_00003.m4s, media/dash_init_0.m4s, media/dash_init_1.m4s, media/dash_init_2.m4s, media/h264_2audio.mp4, media/h264_aac.mp4, media/h264_frames.mp4, media/h264_noaudio.mp4, media/h264_tx3g.mp4, media/hevc_aac.mov, media/hevc_aac.mp4, media/hls_fmp4.m3u8, media/hls_fmp4_audio_en.m3u8, media/hls_fmp4_audio_en_0.m4s, media/hls_fmp4_audio_en_1.m4s, media/hls_fmp4_audio_en_2.m4s, media/hls_fmp4_audio_en_init.mp4, media/hls_fmp4_audio_fr.m3u8, media/hls_fmp4_audio_fr_0.m4s, media/hls_fmp4_audio_fr_1.m4s, media/hls_fmp4_audio_fr_2.m4s, media/hls_fmp4_audio_fr_init.mp4, media/hls_fmp4_subs.m3u8, media/hls_fmp4_subs.vtt, media/hls_fmp4_video.m3u8, media/hls_fmp4_video_0.m4s, media/hls_fmp4_video_1.m4s, media/hls_fmp4_video_init.mp4, media/hls_mpegts.m3u8, media/hls_mpegts_audio_en.m3u8, media/hls_mpegts_audio_en_0.ts, media/hls_mpegts_audio_en_1.ts, media/hls_mpegts_audio_en_2.ts, media/hls_mpegts_audio_fr.m3u8, media/hls_mpegts_audio_fr_0.ts, media/hls_mpegts_audio_fr_1.ts, media/hls_mpegts_audio_fr_2.ts, media/hls_mpegts_subs.m3u8, media/hls_mpegts_subs.vtt, media/hls_mpegts_video.m3u8, media/hls_mpegts_video_0.ts, media/hls_mpegts_video_1.ts, media/tone.flac, media/tone.m4a, media/tone.mp3, media/tone.ogg, media/tone.wav, media/tone_opus.webm, media/vp9_2audio.webm, media/vp9_aac.mp4, media/vp9_opus.webm, win/README.md, win/minimal-resources.pri"
# 111400 is the vendored font's WHOLE size, so a reader that truncated
# into a fixed buffer fails here. "no complaint" is the query's positive
# answer (the empty string) rendered.
expect label#2 "icons/kaya-mark.png present, fonts/sora-wght.ttf: 111400 bytes, no complaint"
