# The sheet's contract (docs/sheet-plan.md §1, §6): a root-hosting modal
# opened by mounting into it, read by title off the platform, written
# through a field inside it, closed through the platform's own cancel
# path, and heard by the app post-fact.
expect_sheets 0
expect label#0 "closed"
click button#0
expect_sheets 1
expect_sheet "new task"
expect label#1 "what needs doing?"
set_text entry#0 "milk"
expect label#2 "draft: milk"
# The desktops have nothing to say about a detent; the phone lanes cut
# this line and append the medium reading (docs/sheet-plan.md §4).
expect_sheet_detent none
# The cancel path: the sheet goes and the app hears sheet_dismissed.
dismiss_sheet
expect_sheets 0
expect label#0 "dismissed"
# Armed: the cancel path asks the app and nothing goes.
click button#1
expect_sheets 1
expect_sheet "new task"
dismiss_sheet
expect label#0 "dismiss requested"
expect_sheets 1
# The chain: a child over the armed parent, dismissed topmost-first.
click button#2
expect_sheets 2
expect_sheet "details"
expect label#last "more about it"
dismiss_sheet
expect_sheets 1
expect label#0 "details dismissed"
expect_sheet "new task"
# A programmatic dismiss echoes nothing: the status the handler wrote stays.
click button#3
expect_sheets 0
expect label#0 "done"
