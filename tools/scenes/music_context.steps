# The media player demo's context menus (docs/media-player-plan.md M26): a
# right-click on the desktops, a long press on the phones. An album card
# offers Play, Add to Queue, Like Album and Go to Artist; a song row Play,
# Play Next, Add to Queue, Like, Go to Album and Go to Artist. Play Next puts
# a song after the playing one and Add to Queue at the queue's end, so the
# dock's next plays them in that order; Go to Album and Go to Artist open the
# page a click does. Like and Like Album say Unlike and Unlike Album once
# liked, each row its own, and take the hearts' toast and Undo. A native
# table's row reads the menu its own right-click opens.
expect_image_phase image@art_201715 shown
expect_context_items column@card_201715 "Play|Add to Queue|-|Like Album|-|Go to Artist"
context_open column@card_201715
menu_activate "Play"
expect label@dock_title "Seven Chimes"
click column@card_581719
expect_image_phase image@track_art[2207899] shown
expect_context_items row@track[2207899] "Play|Play Next|Add to Queue|-|Like|-|Go to Album|Go to Artist"
context_open row@track[2207899]
menu_activate "Like"
expect_toast "Added to Liked Songs|Undo"
expect_context_items row@track[2207899] "Play|Play Next|Add to Queue|-|Unlike|-|Go to Album|Go to Artist"
