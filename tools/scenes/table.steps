# docs/tables-plan.md. column#0 is the For container (the root is a row,
# the reorder scene's rule). A header click is a REQUEST — the platform
# sorts nothing — so the orders below are the GUEST's policy coming back
# through the toolkit: the same column flips, a new column starts
# ascending.
expect_columns column#0 "Name|Size"
expect_column_edges column#0 2
# A table is a viewport: rows may leave slack, never exceed the track
# the grown For received (decision 6).
expect_fills column#0
expect_rows column#0 "banana,30|apple,10|cherry,20"
header_click column#0 0
expect_columns column#0 "Name|Size ^0"
expect_column_edges column#0 2
expect_rows column#0 "apple,10|banana,30|cherry,20"
header_click column#0 0
expect_columns column#0 "Name|Size v0"
expect_column_edges column#0 2
expect_rows column#0 "cherry,20|banana,30|apple,10"
header_click column#0 1
expect_columns column#0 "Name|Size ^1"
expect_column_edges column#0 2
expect_rows column#0 "apple,10|cherry,20|banana,30"
