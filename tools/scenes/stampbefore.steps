# A sibling stamped BEFORE a focused rich textarea leaves its selection
# alone (docs/traps.md, the positional loop). Removal shifts the slots
# back, so it is read too.
expect_title "stampbefore"
expect label@stamped "0 stamped"
click button#3
expect_focused textarea@doc
click button#0
expect_selection textarea@doc "6:11=world"
click button#1
expect label@stamped "1 stamped"
expect_selection textarea@doc "6:11=world"
click button#1
expect label@stamped "2 stamped"
expect_selection textarea@doc "6:11=world"
click button#4
expect_runs textarea@doc "6:11 bold"
click button#2
expect label@stamped "0 stamped"
expect_selection textarea@doc "6:11=world"
