# The media suite's tracks and captions (docs/media-plan.md §3, §7a): each
# item's audio and caption listing (BCP 47 tags, the selection in brackets
# counting from 1), a second audio track selected, the last caption track
# selected, and the current cue read with the player paused at 0.5 s and
# 1.5 s, and once played through. The last item is the floor file with a sidecar WebVTT, which kaya
# parses, times and draws on every platform, so there expect_caption reads
# what kaya's caption renderer drew. `{media:…}` is this lane's table of
# refused items and `{captions:…}` its table of embedded caption tracks it
# does not expose (MP4 text on Windows, settled). The look is never asserted.
expect label#0 "idle"
click button#0
expect label#1 "h264_2audio.mp4"
expect label#0 "ready, can_play yes"
expect label#2 "audio en, fr [1]"
expect label#3 "captions none"
click button#1
expect label#2 "audio en, fr [2]"
click button#0
expect label#1 "vp9_2audio.webm"
expect label#0 "{media:vp9_2audio.webm|ready, can_play yes}"
expect label#2 "{media:vp9_2audio.webm|audio en, fr [1]}"
click button#0
expect label#1 "hls_fmp4.m3u8"
expect label#0 "ready, can_play yes"
expect label#2 "audio en, fr [1]"
expect label#3 "captions en [-]"
click button#1
expect label#2 "audio en, fr [2]"
click button#2
expect label#3 "captions en [1]"
click button#3
expect label#4 "first cue"
click button#4
expect label#4 "second cue"
click button#0
expect label#1 "hls_mpegts.m3u8"
expect label#0 "ready, can_play yes"
expect label#2 "audio en, fr [1]"
expect label#3 "captions en [-]"
click button#2
expect label#3 "captions en [1]"
click button#4
expect label#4 "second cue"
click button#0
expect label#1 "h264_tx3g.mp4"
expect label#0 "ready, can_play yes"
expect label#2 "audio und [1]"
expect label#3 "{captions:h264_tx3g.mp4|captions en [-]}"
click button#2
expect label#3 "{captions:h264_tx3g.mp4|captions en [1]}"
click button#3
expect label#4 "{captions:h264_tx3g.mp4|first cue}"
click button#4
expect label#4 "{captions:h264_tx3g.mp4|second cue}"
click button#0
expect label#1 "h264_aac.mp4 + captions.vtt"
expect label#0 "ready, can_play yes"
expect label#3 "captions en [-]"
expect_caption video#0 ""
click button#2
expect label#3 "captions en [1]"
click button#3
expect label#4 "first cue"
expect_caption video#0 "first cue"
click button#4
expect label#4 "second cue"
expect_caption video#0 "second cue"
# Played through from the start, the cues change on the player's own clock
# (kaya times them at the boundaries the core handed the backend).
click button#6
expect label#4 "second cue"
expect_caption video#0 "second cue"
expect label#4 ""
expect_caption video#0 ""
click button#3
expect label#4 "first cue"
click button#5
expect label#3 "captions en [-]"
expect label#4 ""
expect_caption video#0 ""
