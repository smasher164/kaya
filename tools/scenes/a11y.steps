# EVERY WIDGET KIND is asserted, because the two props are universal:
# tools/check-universal-props.py holds the lowering, this holds the
# runtime.

# DERIVED names: identified but deliberately unlabelled, so the tree
# reports whatever the control took from its own caption.
expect_ax button#0 "button/Save"
expect_ax checkbox#0 "checkbox/Details"
expect_ax button#1 "button/Reset"
expect_ax label#0 "label/Ready"

# AUTHORED names: these kinds draw nothing an assistive client can read.
expect_ax entry#0 "field/Full name"
expect_ax textarea#0 "field/Notes"
expect_ax slider#0 "slider/Volume"
expect_ax progress#0 "progress/Loading"
expect_ax image#0 "image/Logo"

# HINTS are the one prop that is NOT universal: the root admits them on
# activation kinds only. Apple speaks the text as written and Android
# prefixes "double tap to", so it must be a verb phrase reading
# correctly after both.
expect_ax_hint button#0 "save the draft"
expect_ax_hint checkbox#0 "show more detail"

# The CHOICE kinds: each platform spells a chooser differently
# (AXPopUpButton, Compose's dropdown role, ComboBox on AT-SPI and UIA),
# and `combobox` is the closed set's one name for all of them.
expect_ax select#0 "combobox/Color"
expect_ax radio#0 "group/Size"

# CONTAINERS are GROUPS to an assistive client, and naming one is how an
# app declares it a group. All four kinds, since the claim is about
# containers and not about rows.
expect_ax column#0 "group/Form"
expect_ax grid#0 "group/Cells"
expect_ax scroll#0 "group/Feed"
expect_ax row#0 "group/Actions"

# A named group is a landmark, not a lid: its children stay individually
# reachable. The half that regressed once already.
expect_ax button#2 "button/Cancel"
expect_ax button#3 "button/OK"

# A live widget's spoken name follows a SIGNAL. KEYED targets, so these
# widgets move no ordinal above.
expect_ax label@spoken "label/Before"
click button@rename
expect_ax label@spoken "label/After"
