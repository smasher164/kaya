# docs/hidden-plan.md: a row that hides keeps its place and its state. A
# filter is the app's own predicate written into each row's field; the list,
# the 300-row table and the grid show the rows that match, and a row shown
# again is the copy it was, the text typed into it still there.
expect_title "hiderows"
expect_rows column@notes "alpha|beta|gamma"
set_text entry@note[beta] "typed in beta"
set_text search@find_notes "m"
expect_rows column@notes "gamma"
expect_window column@notes 0 1
set_text search@find_notes "zzz"
expect_window column@notes 0 0
set_text search@find_notes ""
expect_rows column@notes "alpha|beta|gamma"
expect_window column@notes 0 3
expect entry@note[beta] "typed in beta"
expect_grid_columns grid@tiles 2
toggle checkbox@hide_two on
expect_grid_columns grid@tiles 2
expect_window column@files 0 300
set_text search@find_files "99"
expect_window column@files 0 3
expect_rows column@files "file 099,99 KB|file 199,199 KB|file 299,299 KB"
set_text search@find_files ""
expect_window column@files 0 300
# Q1 (docs/hidden-plan.md): a hidden scroll keeps its offset and a hidden
# textarea its caret, the ones the user left them at. The caret is the
# user's, moved by a key after the app's selection: a backend that replayed
# the app's request on showing reads 0:5, one that kept nothing 0 or 10.
# Line two starts with line one's three letters, so `press up` lands at 3
# in any font.
scroll_end scroll@strip
expect_at_end scroll@strip
set_text textarea@draft "abcdef\nab"
click button@select_first
expect_focused textarea@draft
expect_selection textarea@draft "0:5=abcde"
type "c"
expect textarea@draft "abcdef\nabc"
expect_selection textarea@draft "10:10="
press up
expect_selection textarea@draft "3:3="
toggle checkbox@hide_pane on
toggle checkbox@hide_pane off
expect textarea@draft "abcdef\nabc"
expect_selection textarea@draft "3:3="
expect_at_end scroll@strip
