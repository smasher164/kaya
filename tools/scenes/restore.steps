# SESSION RESTORATION (docs/restoration-plan.md SR15): the draft comes back
# through the session store after the platform's continuation, and the
# list's scroll and the text's caret come back on their own (SR1, SR4).
expect_title "restore"
expect_restored fresh
expect label#0 "launch fresh"
expect entry#0 ""
set_text entry#0 "half typed"
click button@jump
expect_scrolled_to column@messages m30
click button@select
expect_selection textarea@doc "4:9=quick"

relaunch resume

expect_title "restore"
expect_restored resumed
expect label#0 "launch resumed"
expect entry#0 "half typed"
expect_scrolled_to column@messages m30
expect_selection textarea@doc "4:9=quick"
