# Every host promotes the same first two actions in catalog preorder
# (docs/chrome-plan.md C2), which is why Save and Find are the two read.
expect label#0 "ready"
# BARE, like expect_menu_presentation: capacity k is the platform's own
# number, so the step may assert the invariant and never a count.
expect_toolbar
# Read off the button the platform RENDERED, never off the promotion
# list: the model-agreeing read hid the iOS symbol gap for a whole
# milestone (docs/chrome/toolbar-repo.md §2.4).
expect_toolbar_item "Save" "done"
expect_toolbar_item "Find" "search"
expect_toolbar_item "Save" "enabled"

# The app disables the MENU item and says nothing about any button, so
# the PAIR is the assertion: the two reads come from different trees,
# and a lowering with its own enablement copy passes one and fails the
# other.
click button#0
expect_toolbar_item "Save" "disabled"
expect_menu "File>Save" disabled
click button#0
expect_toolbar_item "Save" "enabled"
expect_menu "File>Save" enabled
