# docs/canvas-plan.md §3.2.1. ALL FOUR CANVASES MUST GROW: an ungrown
# canvas's track IS its viewbox and every policy then agrees, which is
# how the stretch defect shipped green for a milestone. The hash and ink
# bounds are POLICY-BLIND (§7.1), so `expect_raster` alone discriminates.
# --- scale, the default -----------------------------------------------
expect_raster canvas@fit "track"
# Derived by crates/kaya/src/canvas.rs's
# the_size_policy_scene_expectations_are_derived, never typed from a
# platform's read.
expect_drawing canvas@fit "12/5,0,95,100"
expect_drawing_hash canvas@fit "8185fc030ee419b6"
# THE CENTRE, and only the centre: a `scale` canvas letterboxes and a
# `fixed` one is centred by the backend, so an edge probe lands in
# margin on one and in ink on the other.
expect_ink canvas@fit "50,50 = light D2E3F7 dark 212A35"
#
# --- fixed ------------------------------------------------------------
# The same figure and the same grow, raster still the VIEWBOX's size.
# The pair with `scale` above is what makes either of them mean anything.
expect_raster canvas@mark "viewbox"
expect_drawing canvas@mark "12/5,0,95,100"
expect_drawing_hash canvas@mark "8185fc030ee419b6"
expect_ink canvas@mark "50,50 = light D2E3F7 dark 212A35"
#
# --- redraw -----------------------------------------------------------
# NO FROZEN HASH HERE, deliberately: the stream is a function of the
# track, platforms legitimately assign different tracks, and no
# track-dependent stream hashes to one string (§7.1's amendment). The
# bounds are fractions of the canvas's own box and survive that.
expect_raster canvas@live "track"
expect_drawing canvas@live "12/5,0,95,100"
expect_ink canvas@live "50,50 = light D2E3F7 dark 212A35"
#
# --- tick -------------------------------------------------------------
# A LEG'S FRAME COUNT IS PART OF THE SCENE, never the machine's load:
# the bar's right edge IS the frame number, 35 hundredths plus ten per
# frame.
frame
# THE DETERMINISM NEGATIVE: two tenths is twelve frames at 60Hz, so a
# tick driven by the wall clock would be at frame 13 on the next line
# and the bar off the right edge of its box.
settle 200
expect_drawing canvas@clock "6/25,0,45,100"
frame 2
expect_drawing canvas@clock "6/25,0,65,100"
expect_raster canvas@clock "track"
#
# NO `expect_ax` HERE, structurally: a canvas being an image to an
# assistive client is canvas.steps' assertion (§9), on the scene wired
# through the linux a11y bus leg.
