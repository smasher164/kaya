# docs/virtualization-plan.md §5, the correction path on purpose: rows
# differ in height by STRUCTURE (row 0 is one line, row 1 is three), so
# the presumption from the first realized row fails at the second.
# EVERY EXPECTATION IS A CORRECTION-STABLE FACT — membership by row
# identity, the first index after a move, the declared total, one row's
# content — and NEVER an extent, which is platform- and
# history-dependent on this path.
expect label#0 "300 rows, 845 lines"
# A windowed For's total is what the guest INSERTED, never what the
# platform realized.
expect_window column@varied 0 300
# Each row's own For carries the row's key as its automation id, so one
# row's lines read out alone and say nothing about how many copies exist.
expect_order column@r000 "r000 line 1"
# Deep past rows the band never realized, every position PRESUMED from
# row 0's pitch: the scroll follows a ROW, reachable by identity.
scroll_to_row column@varied r200
expect_window column@varied 200 300
# r200's four lines were inserted during the build, when it had no
# widgets at all: a nested collection's instance belongs to the ROW, not
# to its stamp.
expect_order column@r200 "r200 line 1|r200 line 2|r200 line 3|r200 line 4"
# The prefix sums above the viewport are CORRECTED now and were presumed
# before: correction moves arithmetic, never membership, so these two
# lines are byte-identical to the two above.
scroll_to_row column@varied r000
expect_window column@varied 0 300
# r000's copy was torn down and stamped again: teardown takes widgets
# and leaves data.
expect_order column@r000 "r000 line 1"
# THE ANCHORING ASSERTION (plan §5): visiting r100 corrects the heights
# above r150 and therefore its pixel position, and scroll position is
# anchored to ROW IDENTITY — so a correction above the viewport moves
# the scrollbar and not the content under the reader's eyes.
scroll_to_row column@varied r150
expect_window column@varied 150 300
scroll_to_row column@varied r100
expect_window column@varied 100 300
scroll_to_row column@varied r150
expect_window column@varied 150 300
