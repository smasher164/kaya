# One command catalog, adapted by each host: native menu chrome on the
# desktops, overflow plus one promoted item on the phones.
expect label#0 "ready"
expect_menus 3
expect_menu "File>Save" disabled
expect_menu "File>Export" disabled
# THE SYMBOL VOCABULARY (docs/styling-plan.md D6), read off the REAL
# tree. ITEMS ONLY, never a top-level grouping: Windows' MenuBarItem has
# no icon slot, so a top-level symbol is not the 4/4 intersection.
expect_menu_symbol "File>Save" "done"
expect_menu_symbol "File>Export" "forward"
expect_menu_symbol "View>Details" "info"
expect_menu "View>Details" unchecked
expect_menu "Sort" value 0

# The depth guest deliberately does not write the bound signals back:
# the native control owns user state.
menu_activate "View>Details"
expect_menu "View>Details" checked
expect label#0 "details on"
menu_activate "Sort>Date"
expect_menu "Sort" value 1
expect label#0 "sorted date"

# File owns the same signal as its Export leaf, so this unrelated prop
# mutation REBUILDS the catalog: the stateful controls must survive from
# the backend's user-state mirror.
click button#0
expect_menu "File>Save" enabled
expect_menu "File>Export" enabled
expect_menu "View>Details" checked
expect_menu "Sort" value 1

menu_activate "File>Save"
expect label#0 "saved"

# Programmatic checked/value writes are configuration and stay quiet.
# The deliberate absence-settle: an illicit echo overwrites the "ready"
# sentinel with "details off"/"sorted name".
click button#1
expect_menu "View>Details" unchecked
expect_menu "Sort" value 0
settle 700
expect label#0 "ready"

# Starting from "ready" makes this a delivery fence rather than a
# pre-satisfied assertion a late accelerator could bleed through.
shortcut "primary+s"
expect label#0 "saved"

# The second context target is a STAMPED row, so its occurrence carries
# both collection keys.
context_open label#1
menu_activate "Rename"
expect label#0 "renamed"
context_open label#2
menu_activate "Remove"
expect label#0 "removed g2/a"

# Label and topology mutate in a later transaction: File renamed,
# Publish appended to that RETAINED parent, Tools a fourth root, and the
# primary hint moved from Share to Publish.
click button#2
expect_menus 4
expect_menu "Document>Publish" enabled
expect_menu "Tools>Inspect" enabled
expect_menu_symbol "Document>Publish" "copy"
expect_menu_symbol "Tools>Inspect" "search"

# No More-open step precedes this: on phones the helper the rendered
# toolbar consumed must surface the late primary itself.
menu_activate "Document>Publish"
expect label#0 "shared"

# BARE on purpose: the literal differs per lane (regular/bar on
# desktops, compact/overflow on phones) while the invariant holds
# everywhere. ASYMMETRIC by design — a compact window showing a bar is
# legitimate; a REGULAR window hiding its catalog behind the compact
# overflow is the iPadOS 26 defect this guards.
expect_menu_presentation
