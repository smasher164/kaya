# The media reader and the canvas's image op (docs/media-plan.md §8 rulings
# 3 and 4): a reader with no player. h264_frames.mp4 has grey bands at
# frames 12 and 37 (480 and 1480 ms) and one keyframe, at 0, so an exact
# read answers each time with its own picture and a keyframe read with
# frame 0 at 0 ms.
expect label#0 "exact 480@480 1480@1480 completed"
expect label#1 "keyframe 480@0 1480@0 completed"
expect label#2 "peaks 48000 Hz, 1 ch, 20 pairs of 4800, -4095..4095"
# A file that is not media and a file that is not there fail with the
# player's reasons.
expect label#3 "OFL.txt failed unsupported_container; missing.mp4 failed not_found"
# A read for a track the source lacks (tone.mp3's frames, h264_noaudio.mp4's
# peaks) answers no_track (docs/media-plan.md §8 ruling 4).
expect label#4 "mp3 frames failed no_track; noaudio peaks failed no_track"
expect_drawing canvas@strip "4/0,0,100,100"
# The filmstrip is the PLATFORM's decode, so no hash is frozen for it: the
# tiles' centres read the bands and the keyframe's flat colour.
expect_ink canvas@strip "12,50 37,50 62,50 87,50 = light 505050/A0A0A0/C83C1E/C83C1E dark 505050/A0A0A0/C83C1E/C83C1E"
# THE WAVEFORM IS FROZEN FROM THE CORE (crates/kaya/src/reader.rs,
# the_reader_scene_waveform_is_derived_from_the_core): tone.wav is 16-bit PCM,
# so every platform's decode hands the core the file's own samples, and the
# two images are decoded by the core. The ink reads the PNG's red corner and
# the JPEG's sea.
expect_drawing canvas@wave "122/4,7,95,100"
expect_drawing_hash canvas@wave "4dc19c1911f74793"
expect_ink canvas@wave "76,10 85,92 = light FF0000/306F9A dark FF0000/306F9A"
# Two reads the local server never finishes (its /trickle/ prefix): one
# cancelled, one under a reader that is closed. Their label sits below the
# two buttons.
click button#0
expect label#5 "reading"
click button#1
expect label#5 "closed cancelled; trickle cancelled"
