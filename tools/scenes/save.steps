# docs/save-plan.md D5. EVERY ASSERTION IS A READ-BACK OFF THE DISK,
# because a write that returns success and lands nowhere is exactly the
# failure "save" has. The files are the guest's own, at
# <temp>/kaya-save-<pid>/, named by BASENAME only. NO EXTENSIONS ON ANY
# NAME: a save panel hides a known extension when the user's Finder
# preference says so, and `expect_save_dialog` would then read the stem
# on one machine and the whole name on another.
expect label#0 "no file"

# ARM THE DIRECTORY FIRST: a panel honors its initial location only AT
# presentation, and otherwise restores wherever it was last — one run
# inherited a directory an unrelated binary had left behind.
file_dialog_goto $TMP/kaya-save-$PID
click button#0

# THE DECOY IS LOAD-BEARING: with ONE file in the directory a dialog
# completes with it when nothing is selected, so `file_choose` would
# pass on a backend that never selected anything. "decoy" sorts first,
# so such a backend gets the WRONG file and fails below.
expect_file_dialog kaya-save-$PID decoy draft
file_choose draft
expect label#0 "opened first draft"

# SAVE-BACK: no dialog, because the user already chose this file and the
# handle they chose it with is writable (DESIGN.md).
click button#1
expect label#0 "saved second draft"

# CANCEL IS TWO ASSERTIONS: the empty answer reaches the guest as "no
# destination", AND the dialog id retires — otherwise the second show
# below trips the one-live-dialog-per-process guard and the guest panics.
file_dialog_goto $TMP/kaya-save-$PID
click button#2
expect_save_dialog kaya-save-$PID copy
file_save cancel
expect label#0 "save cancelled"

# SAVE AS: the panel opens on the name the guest SUGGESTED and the
# harness types over it. A backend that ignored the typing saves under
# "copy", where every byte assertion below still passes against the
# wrong file — which is what the read-back catches.
file_dialog_goto $TMP/kaya-save-$PID
click button#2
expect_save_dialog kaya-save-$PID copy
file_dialog_name final
expect_save_dialog kaya-save-$PID final
file_save

# THE DESTINATION DID NOT EXIST: this line fails with "No such file or
# directory" unless the core's save source creates it (save-plan D1).
expect label#0 "saved third draft"

# BOTH FILES, REOPENED: a save-as that wrote through the ORIGINAL handle
# — the plausible bug, since the guest holds two lookalike handles —
# passes every line above and fails here.
click button#3
expect label#0 "reopened second draft third draft"

# One REAL-TREE read at the end: everything above reads kaya's own model
# and would pass for an arm that ran and drew nothing.
expect_ax label#0 "label/reopened second draft third draft"
