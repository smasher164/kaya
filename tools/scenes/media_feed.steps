# A video view in a collection row (docs/media-plan.md §7b): ten rows in a
# scroll, each a video view showing its row's own player, paused on its
# first frame. The first and last rows' visibility is read in label#0 and
# label#1 as the feed app reads it; the core coalesces the scroll's frames
# into entering, leaving, tenths and whole.
expect label#0 "r0 whole"
expect label#1 "r9 out"
expect_video_ink video#0 "C83C1E"
scroll_end scroll#0
expect label#1 "r9 whole"
expect label#0 "r0 out"
expect_video_ink video#9 "C83C1E"
