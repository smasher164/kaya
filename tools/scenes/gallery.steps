# image#1 carries deliberately invalid bytes: a failed decode reads 0x0
# and KEEPS the node (tools/check-empty-child.py).
expect label#0 "urgent: false"
toggle checkbox#0 on
set_value slider#0 0.75
expect label#0 "urgent: true"
expect label#1 "volume: 75%"
expect image#0 "2x2"
expect image#1 "0x0"
# The echo negative test: button#0 writes the slider's signal to 0.25
# PROGRAMMATICALLY, which may fire no value_changed — a backend that
# echoes programmatic writes reads "volume: 25%" here.
click button#0
# The one DELIBERATE settle in the scenes: the expect below asserts an
# ABSENCE, and polling cannot prove one.
settle 700
expect label#1 "volume: 75%"
