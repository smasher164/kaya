# The covered root is retained: label#0 takes writes while covered. The
# settings round's last status pins that a programmatic pop_entry does
# NOT echo entry_popped.
expect_entries 0
expect_title "nav"
click button#0
expect_entries 1
expect_title "detail"
expect label#last "detail pane"
back
expect_entries 0
expect label#0 "popped detail"
expect_title "nav"
click button#1
expect_entries 1
expect_title "settings"
back
expect_entries 0
expect label#0 "back requested"
expect_title "nav"
