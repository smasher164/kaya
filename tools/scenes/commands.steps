expect label#0 "ready"
expect_menus 2
expect_menu "File>Settings…" enabled
expect_menu "View>Details" unchecked
expect_menu "View>Sort" value 0

shortcut "primary+backslash"
expect_menu "View>Details" checked
expect label#0 "details on"

shortcut "primary+2"
expect_menu "View>Sort" value 1
expect label#0 "sorted date"

# macOS displays this item in the application menu, but it stays
# addressed where the app DECLARED it, and the chord is the app's own.
shortcut "primary+comma"
expect label#0 "settings 1"

menu_activate "File>Settings…"
expect label#0 "settings 2"
