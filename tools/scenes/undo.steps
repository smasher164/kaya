# DESIGN.md, Menus; docs/undo-plan.md D1-D6 and §3. WHAT THIS SCENE IS
# FOR is the ORDER: two bare stacks with no total order between them
# walk "type a, act X, type b" back as b, a, X, through a state that
# never existed, and this script asserts b, X, a. The FRONTIER'S
# GRANULARITY is platform-flavored where the order is not, so every
# assertion is about the STATE a step restores, and TYPING IS REAL
# KEYSTROKES (set_text would clear the native history this is made of).
expect label#0 "no todos"
expect label#1 "history empty"
expect label#2 "no keys"

# Enablement is not a build-time fact and no app computes it: it is
# "does anything answer this right now", asked live.
expect_menu "Edit>Undo" disabled
expect_menu "Edit>Redo" disabled

# ---- the scenario that motivated the milestone --------------------
#
# The add appends a todo AND empties the field, so one Undo must take
# back the ADD. Under two unordered stacks it takes back the CLEAR —
# "milk" returns and the todo stays.
click button#2
expect_focused entry#0
type "milk"
expect entry#0 "milk"
expect_menu "Edit>Undo" enabled
click button#0
expect label#0 "added milk, 1 total"
# THE MINTER'S FIRST ANSWER: the app passed no key, and every language
# mints the same I64 sequence from 1 (docs/fresh-key-plan.md). label#2
# is the APP'S OWN MIRROR of its collection's keys, and every label#2
# assertion stands behind the label#0/#1 assertion written in the SAME
# transaction: after an undo the core restores before the app hears the
# occurrence, so a bare read could match the restored value too early.
expect label#2 "keys 1"
expect entry#0 ""

menu_activate "Edit>Undo"
expect label#0 "no todos"
expect label#1 "undid add milk, 0 total"
expect label#2 "no keys"
# AND THE FIELD IS UNTOUCHED: the clear was never a step, so undoing the
# add cannot put the draft back beside a todo that is gone.
expect entry#0 ""

menu_activate "Edit>Redo"
expect label#0 "added milk, 1 total"
expect label#1 "redid add milk, 1 total"
expect label#2 "keys 1"
expect entry#0 ""

# ---- the interleave: type, act, type, walk back -------------------
click button#2
type "tea"
expect entry#0 "tea"
click button#1
expect label#0 "starred"
click button#2
# TYPING APPENDS (harness.rs Stage::type_text, contract point 3): macOS
# SELECTS A FIELD'S WHOLE CONTENTS when it becomes first responder, so a
# backend that skips the caret move reads "s" for "teas" right here.
type "s"
expect entry#0 "teas"

# b — the newest thing that happened is the newest thing undone.
menu_activate "Edit>Undo"
expect entry#0 "tea"

# ---- and a step back is a step forward, WHICHEVER TIER TOOK IT ----
# The field's own stack is spent, so without the ledger BANKING the
# episode forward the run would be gone for good. THE ENABLEMENT IS READ
# FIRST, the falsifiable half: unbanked, Edit>Redo is inert and no
# assertion about text could say why. ASKED BEFORE THE NEXT APP ACTION,
# since a banked episode is forward history the next step commits over
# (scene.rs's a_new_step_after_a_banked_walk_spends_the_forward_history).
expect_menu "Edit>Redo" enabled
menu_activate "Edit>Redo"
expect entry#0 "teas"
expect label#1 "redid typing, 1 total"
menu_activate "Edit>Undo"
expect entry#0 "tea"
expect label#1 "undid typing, 1 total"

# X — the app's step, in the order it happened rather than after every
# text edit on the other stack.
menu_activate "Edit>Undo"
expect label#0 "added milk, 1 total"
expect label#1 "undid star, 1 total"
# a — the earlier typing last, one coarse step back to where it began.
menu_activate "Edit>Undo"
expect entry#0 ""
expect label#1 "undid typing, 1 total"

# ---- the delta is the only notification, AND IT IS FALSIFIABLE ----
# Restoring text is a programmatic write and emits no text_changed, so
# an app learns it from the payload or not at all. THIS ADD IS THE
# PROOF, at the one moment the widget's draft and the app's disagree: an
# app ignoring `delta.texts` still holds "tea" and its add ADDS. One
# step later, at the add after the redo, it CANNOT fail (measured
# vacuous on the Java and Haskell lanes). A refusal is not a step.
click button#0
expect label#0 "nothing to add, 1 total"

# The other half of the fold: the redo writes "tea" programmatically and
# emits nothing, and the refusal above proved the draft was "" a moment
# ago, so the name can only have come from the payload.
menu_activate "Edit>Redo"
expect entry#0 "tea"
expect label#1 "redid typing, 1 total"
click button#0
expect label#0 "added tea, 2 total"
# A FRESH KEY IS FRESH FOREVER: a counter that rewound would mint 1
# again here and collide with the milk that is still there.
expect label#2 "keys 1,2"
expect entry#0 ""

# THE STATUS COMES BACK TO WHAT THE REFUSAL WROTE, not to what the
# previous add wrote: a group restores the signal it overwrote to the
# value it found there, whoever put it there and whether that writer was
# a step.
menu_activate "Edit>Undo"
expect label#0 "nothing to add, 1 total"
expect label#1 "undid add tea, 1 total"
expect label#2 "keys 1"

# ---- the remove: the case where identity IS what undo asserts -----
#
# An undone remove that came back under a new key, or at the end instead
# of where it was, satisfies every COUNT in this file and is still
# wrong, so both are read off label#2.
menu_activate "Edit>Redo"
expect label#0 "added tea, 2 total"
expect label#1 "redid add tea, 2 total"
expect label#2 "keys 1,2"

# The remove takes the collection's FIRST entry, so the entry that comes
# back has to come back BEFORE the one that stayed.
click button#3
expect label#0 "removed milk, 1 total"
expect label#2 "keys 2"

menu_activate "Edit>Undo"
expect label#0 "added tea, 2 total"
expect label#1 "undid remove milk, 2 total"
# ITS ORIGINAL KEY, AT ITS ORIGINAL POSITION: a mirror that folds the
# entries run and drops the orders run reads "keys 2,1" here, and one
# that folds neither reads "keys 2".
expect label#2 "keys 1,2"

menu_activate "Edit>Redo"
expect label#0 "removed milk, 1 total"
expect label#1 "redid remove milk, 1 total"
expect label#2 "keys 2"

# ---- and one level down: a ROW's field is a field too --------------
# A row's field has no id an app could hold — its identity is (template
# node, key path) — which is why the payload's texts run is an
# arity-first group (docs/undo-plan.md §3b). `#last` ON PURPOSE: six row
# copies have been stamped and four destroyed, and a backend need not
# prune its harness registry. AND THE EDIT IS `set_text`, since nothing
# can FOCUS a stamped copy, so this asserts the LEDGER's half only.
click button#2
type "jam"
click button#0
expect label#0 "added jam, 2 total"
# A THIRD FRESH KEY, after walks back and forward over both earlier
# todos.
expect label#2 "keys 2,3"
set_text entry#last "ha"
# label#3 IS THE APP'S OWN MAP of what is typed in the rows, by key —
# never a widget read.
expect label#3 "notes 3=ha"

menu_activate "Edit>Undo"
expect label#1 "undid typing, 2 total"
# THE FALSIFIABLE HALF, and the only one of the two: an app that ignores
# the payload's texts run still holds "3=ha" and reads it back here. The
# redo below cannot catch that alone — ignoring BOTH directions ends up
# at "notes 3=ha" and the two ignores cancel.
expect label#3 "no notes"
# ...and the widget followed: the core wrote the text back into whichever
# copy carries that template node at that key right now.
expect entry#last ""

menu_activate "Edit>Redo"
expect label#1 "redid typing, 2 total"
expect label#3 "notes 3=ha"
expect entry#last "ha"
