# The task manager (docs/tasks-plan.md §2), one scene for every screen.
# Rows are addressed by authored id and key: a task lives in exactly one
# list at a time, so `label@title[t3]` names its current copy wherever it
# sits. The clock is fixed at Monday 2026-09-07 under the harness. Five
# sections (R4): the Logbook and Settings are View-menu screens pushed
# onto the active section's stack.
expect_title "tasks"
expect_sections 5
expect_section "Inbox"
# THE SYMBOLS THE ROWS REALLY DRAW (docs/chrome/sections-symbol.md): these
# sections live in window#0, so the sidebar arm is asserted on every lane
# — the desktops' sidebar rows and the phones' bar.
expect_section_symbol "Inbox" "home"
expect label@inbox_count "2 in inbox"
expect label@title[t1] "Buy milk"
# The list spans its section and a task row spans the list (R7): the
# list is the one that hugged. The row's centre default (R5) is held by
# align.steps, whose row is built to separate centre from baseline; a
# row of same-size text reads both on Compose.
expect_breadth column@inbox_list
expect_fills row@task[t1]
expect label@title[t2] "Call the plumber"
expect label@caption[t2] ""

# Quick-add lands in Inbox; the field clears and keeps focus (todos.steps).
set_text entry@quick "Buy oat milk"
click button@add
expect label@inbox_count "3 in inbox"
expect label@title[t10] "Buy oat milk"
expect entry@quick ""
expect_focused entry@quick

# S1 (docs/search-plan.md S10): each list's search field filters that list
# alone by title and notes, and the count caption says how many match; the
# clear affordance restores the list with the focus kept.
expect_placeholder search@inbox_find "Search"
set_text search@inbox_find "oat"
expect label@inbox_count "1 of 3 match"
expect label@title[t10] "Buy oat milk"
expect_window column@inbox_list 0 1
clear_search search@inbox_find
expect search@inbox_find ""
expect label@inbox_count "3 in inbox"
expect_window column@inbox_list 0 3

# Today: the routed rows, and a completion that moves one to the Logbook.
select_section 1
expect_section "Today"
expect_section_symbol "Today" "star"
expect label@today_count "2 today"
expect_section_badge "Today" 2
expect label@title[t3] "Draft chapter 3"
expect label@caption[t3] "Mon 7 Sep, Thesis"
expect label@caption[t4] "Mon 7 Sep"
toggle checkbox@done[t3] on
expect label@today_count "1 today"
expect_section_badge "Today" 1

# The Logbook is a View-menu screen on the active section's stack; a
# task reopened there leaves it and returns to its list.
menu_activate "View>Logbook"
expect_entries 1
expect label@logbook_count "2 done"
expect label@lb_title[t3] "Draft chapter 3"
toggle checkbox@lb_done[t3] off
expect label@logbook_count "1 done"
back
expect_entries 0
expect label@today_count "2 today"
expect_section_badge "Today" 2

# Upcoming and Anytime read the seed's routing.
select_section 2
expect_section "Upcoming"
expect label@upcoming_count "2 upcoming"
expect label@caption[t5] "Wed 9 Sep, Trip"
expect label@caption[t8] "Sat 12 Sep, Thesis"
select_section 3
expect_section "Anytime"
expect label@anytime_count "2 anytime"
expect label@caption[t6] "due Wed 30 Sep, Trip"
expect label@caption[t7] "Kitchen"

# Details: a when-date set on the pushed screen re-routes the task.
select_section 0
click button@details[t2]
expect_entries 1
expect textarea@notes ""
# A text field fills its column (R10).
expect_breadth textarea@notes
# The picker's accessibility name IS its row's label (docs/forms-plan.md §4).
expect_ax date_picker@when "datetime/When: none"
# A link in the notes (S2, R14): the platform's link and its destination.
expect_placeholder textarea@notes "Notes"
expect_href label@reference "https://example.com/tasks/t2"
expect_ax label@reference "link/Reference"
set_date date_picker@when 2026-09-08
expect_ax date_picker@when "datetime/When: Tue 8 Sep"
back
expect_entries 0
# A popped screen's widgets answer no target (harness.rs ExpectNoTarget).
expect_no_target date_picker@when
expect label@inbox_count "2 in inbox"

# A reminder is a notification at its time (S3, N7): the observation is the
# platform's own delivered list, clearing cancels it, and activating the
# posted one opens that task's details.
click button@details[t1]
expect_entries 1
# 08:30, not the bound default (09:00): the same value drives nothing.
set_time time_picker@reminder 08:30
expect_ax time_picker@reminder "datetime/Reminder: 08:30"
expect_notification 1 "Buy milk"
click button@clear_reminder
expect_no_notification 1
set_time time_picker@reminder 09:30
expect_ax time_picker@reminder "datetime/Reminder: 09:30"
# THE SAME ID AS THE POST BEFORE IT (docs/tasks-s9-plan.md R2): the id is
# the task's own key, so a re-post replaces rather than piling up.
expect_notification 1 "Buy milk"
back
expect_entries 0
notification_activate 1
expect_entries 1
expect_href label@reference "https://example.com/tasks/t1"
expect_no_notification 1
click button@clear_reminder
back
expect_entries 0
expect_no_target time_picker@reminder
select_section 2
expect label@upcoming_count "3 upcoming"
expect label@caption[t2] "Tue 8 Sep"

# The project screen: keyed Open, its own quick-add, and reorder by drag.
select_section 4
expect_section "Projects"
expect label@name[trip] "Trip"
expect label@pcount[trip] "2 tasks"
click button@open[trip]
expect_entries 1
expect_order column@rows "Book the flights|Renew passport"
drag label@ptitle[t6] to label@ptitle[t5] before
expect_order column@rows "Renew passport|Book the flights"
set_text entry@pquick "Pack chargers"
click button@padd
expect_order column@rows "Renew passport|Book the flights|Pack chargers"
back
expect_entries 0
expect label@pcount[trip] "3 tasks"
select_section 3
expect label@anytime_count "3 anytime"
expect label@caption[t11] "Trip"

# Delete from the details screen, then Edit>Undo brings the row back.
select_section 0
click button@details[t1]
expect_entries 1
click button@delete
expect_entries 0
expect label@inbox_count "1 in inbox"
expect_menu "Edit>Undo" enabled
menu_activate "Edit>Undo"
expect label@inbox_count "2 in inbox"
expect label@title[t1] "Buy milk"

# Settings: promoted into the chrome, pushed onto the active section.
menu_activate "View>Settings"
expect_entries 1
expect label@settings[s] "Week starts Monday; badge shown; completed move to Logbook"
choose select@week[s] 1
# The two settings are switches (S2, R12): the platform's switch trait.
expect_ax checkbox@hide_badge[s] "switch/Hide the Today badge"
toggle checkbox@hide_badge[s] on
expect label@settings[s] "Week starts Sunday; badge hidden; completed move to Logbook"
expect_section_badge "Today" 0
toggle checkbox@keep_done[s] on
expect label@settings[s] "Week starts Sunday; badge hidden; completed stay in place"
# The app-wide appearance (S2b): the select writes the window prop, and
# the observation is the PLATFORM's own reading, never the prop. System is
# the toolkit's override slot read back EMPTY — a host in Dark at night
# reads dark there, which "light" would have called a failure.
choose select@appearance[s] 2
expect_appearance "dark"
choose select@appearance[s] 0
expect_appearance "system"
back
expect_entries 0
select_section 3
expect label@anytime_count "4 anytime"
expect label@caption[t9] "Kitchen"

# S9 — THE CLOSED-APP CLICK (docs/tasks-s9-plan.md): the reminder is
# posted, `relaunch` ends act one, and the process the platform starts on
# the tap opens that task's details with no memory of this one. The two
# lines after `relaunch` are act two, and they run over there.
select_section 0
click button@details[t1]
expect_entries 1
set_time time_picker@reminder 10:30
expect_notification 1 "Buy milk"
back
expect_entries 0
relaunch
expect_entries 1
expect_href label@reference "https://example.com/tasks/t1"
