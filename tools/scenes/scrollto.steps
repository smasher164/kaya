# THE APP'S SCROLL-TO (docs/scroll-to-plan.md §5): a scroll holding a
# column of sixty message rows. The build inserted them and scrolled to
# the newest BEFORE anything laid out, so the first step is the chat
# app's opening frame (S4). Then a handler scrolls to a row (S2), a
# handler names a key no row holds and nothing moves (S3), and a handler
# inserts a row and follows it to the end.
expect label@count "60 messages"
expect_at_end scroll#0
click button@jump
expect_scrolled_to column@messages m10
click button@nowhere
expect_scrolled_to column@messages m10
expect label@count "60 messages"
click button@send
expect label@count "61 messages"
expect_at_end scroll#0
