<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- THE CLIPBOARD SCENE'S FOREIGN APP: a package this one cannot
         SEE is a package it cannot broadcast to, explicit component or
         not, and the failure is silent (docs/traps.md: "An explicit broadcast to a package the
         sender cannot SEE is filtered out with no error").
         Harness-only, so it is declared here and not in the kaya
         library's manifest — the same call the accessibility service
         below makes, for the same reason. -->
    <queries>
        <package android:name="dev.kaya.cliphelper" />
    </queries>
    <!-- THE APP'S DECLARED IDENTITY, READ OUT OF ONE FILE
         (docs/app-identity-plan.md ruling 4): both the mark and the
         label are placed by android/build.gradle.kts. Neither is
         written here, because one more copy of the label is how "one
         mark, one name" stops being true without anybody editing it. -->
    <application
        android:icon="@mipmap/kaya_mark"
        android:label="${kayaAppLabel}"
        android:theme="@style/Theme.Kaya.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- THE HARNESS'S EYES OUTSIDE THIS APP: DocumentsUI is a
             separate APK and this is what lets a scene drive it.
             Declared by the validation apps and never by the kaya
             library, so a user's app never carries it; the runner
             enables it over adb. -->
        <service
            android:name="dev.kaya.KayaHarnessAccessibility"
            android:exported="false"
            android:label="kaya harness"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kaya_harness_accessibility" />
        </service>
    </application>
</manifest>
