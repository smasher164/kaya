<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- THE CLIPBOARD SCENE'S FOREIGN APP: a package this one cannot
         SEE is a package it cannot broadcast to, explicit component or
         not, and the failure is silent (docs/traps.md: "An explicit broadcast to a package the
         sender cannot SEE is filtered out with no error").
         Harness-only, so it is declared here and not in the kaya
         library's manifest — the same call the accessibility service
         below makes, for the same reason. -->
    <!-- LOCAL NOTIFICATIONS (docs/tasks-s3-plan.md N2, N3). Declared by
         the APP and not by the kaya library: POST_NOTIFICATIONS is the
         runtime prompt the first post asks for on API 33+ (the lane
         pre-grants it over adb), and USE_EXACT_ALARM is a claim about
         what this app IS — a reminders app qualifies, and a library may
         not make that claim for every app built on it. SCHEDULE_EXACT_ALARM
         is its pre-33 spelling, granted at install there. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <queries>
        <package android:name="dev.kaya.cliphelper" />
    </queries>
    <!-- THE APP'S DECLARED IDENTITY, READ OUT OF ONE FILE
         (docs/app-identity-plan.md ruling 4): both the mark and the
         label are placed by android/build.gradle.kts. Neither is
         written here, because one more copy of the label is how "one
         mark, one name" stops being true without anybody editing it.
         The theme is the LAUNCH one (docs/tasks-s2-plan.md T4); the
         activity wears Theme.Kaya.NoActionBar from installSplashScreen()
         on. -->
    <application
        android:icon="@mipmap/kaya_mark"
        android:label="${kayaAppLabel}"
        android:theme="@style/Theme.Kaya.Launch">
        <!-- APP LINKS (docs/app-links-plan.md L3, §4). `singleTask` so a
             link tapped while this app runs re-enters the LIVE activity
             through onNewIntent instead of stacking a second one; the
             VIEW filter claims the declared scheme, which is the
             placeholder android/build.gradle.kts reads out of
             guests/assets/identity.toml (a literal here would be one more
             copy of a value declared once). THE LAUNCH MODE HAS A PRICE
             THE SHELL PAYS: a warm explicit start now arrives at
             onNewIntent, so the KAYA_* env mapping runs from both doors
             (KayaEnv.fromIntent; tools/check-jni.py's manifest census). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${kayaLinkScheme}" />
            </intent-filter>
        </activity>
        <!-- THE HARNESS'S EYES OUTSIDE THIS APP: DocumentsUI is a
             separate APK and this is what lets a scene drive it.
             Declared by the validation apps and never by the kaya
             library, so a user's app never carries it; the runner
             enables it over adb. -->
        <service
            android:name="dev.kaya.KayaHarnessAccessibility"
            android:exported="false"
            android:label="kaya harness"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kaya_harness_accessibility" />
        </service>
    </application>
</manifest>
