<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- THE PLATFORM THEME EVERY KAYA APP DECLARES. The window
         background and everything drawn before the first Compose frame
         come from the MANIFEST theme, which no Compose theme reaches, so
         a hard LIGHT theme here is a half-dark app (docs/traps.md: "A hard Light manifest theme
         is a half-dark app the Compose theme cannot reach"; docs/styling-plan.md D1). DAY/NIGHT WITHOUT
         APPCOMPAT, through the `-night` qualifier. NoActionBar: a
         platform action bar is double chrome and shifts every
         window-space rectangle the pixel witness aims at. -->
    <style name="Theme.Kaya.NoActionBar"
        parent="@android:style/Theme.Material.Light.NoActionBar" />

    <!-- THE LAUNCH SLOT (docs/tasks-s2-plan.md T4). This is the theme
         the MANIFEST names, and `postSplashScreenTheme` is what the
         activity wears from installSplashScreen() on — so the theme
         above still decides every pixel the app itself draws, and this
         one decides only what the platform draws before the app exists.
         THE CALL IS NOT OPTIONAL: without it the activity keeps the
         splash theme for its whole life and the window background stays
         the launch colour, which is why tools/check-app-identity.py
         holds every app module's activity to making it.

         `core-splashscreen` rather than the bare `android:` attributes:
         those exist from API 31 and the app modules declare minSdk 26,
         so the platform route would honour the declaration on the lane's
         API-35 emulator and on nothing else. The colour and the drawable
         are generated by android/build.gradle.kts out of the one
         declaration. -->
    <style name="Theme.Kaya.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kaya_launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/kaya_launch_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Kaya.NoActionBar</item>
    </style>
</resources>
