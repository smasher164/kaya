<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The night half of the pair in values/themes.xml. Same two names,
         dark platform parents: the system picks this file whenever the
         device is in night mode, before any of kaya's code runs. -->
    <style name="Theme.Kaya" parent="@android:style/Theme.Material" />

    <style name="Theme.Kaya.NoActionBar" parent="@android:style/Theme.Material.NoActionBar" />
</resources>
