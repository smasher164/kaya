<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The bytes half of a clip (docs/clipboard-plan.md §7), in the
             LIBRARY's manifest because every kaya app has it, unlike the
             harness service the validation apps declare.
             THE AUTHORITY IS PER APPLICATION ID: two packages declaring
             one is INSTALL_FAILED_CONFLICTING_PROVIDER on the second
             install, and KayaClipProvider.authority(context) must keep
             computing this same string. -->
        <!-- THE SCHEDULED POST'S OWN PROCESS (docs/tasks-s3-plan.md
             N2): AlarmManager fires this, and it posts — in a cold
             process too, since the OS fires an alarm whether or not the
             app is running. In the LIBRARY's manifest for the clip
             provider's reason: every kaya app that schedules a reminder
             needs this one receiver, and not one of its own. -->
        <receiver
            android:name="dev.kaya.KayaNotificationAlarm"
            android:exported="false" />
        <!-- A NOTIFICATION REPLY'S OWN PROCESS (docs/notification-reply-plan.md):
             the Reply action's RemoteInput broadcast lands here, in a process
             with no Activity when the app is not running, and starts the guest
             through the app's dev.kaya.guest_start. -->
        <receiver
            android:name="dev.kaya.KayaNotificationReply"
            android:exported="false" />
        <!-- THE MEDIA SESSION'S SERVICE (docs/media-plan.md §5): a
             mediaPlayback foreground service posting the MediaStyle
             notification, in the LIBRARY's manifest for the receivers'
             reason. The app that declares a session declares its
             permissions: FOREGROUND_SERVICE, FOREGROUND_SERVICE_MEDIA_PLAYBACK
             and, from Android 13, POST_NOTIFICATIONS. -->
        <service
            android:name="dev.kaya.KayaMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <provider
            android:name="dev.kaya.KayaClipProvider"
            android:authorities="${applicationId}.clip"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
