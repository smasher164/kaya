<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The clipboard scene's foreign app: without this the guest cannot
         see the helper, and an explicit broadcast to a package you
         cannot see is filtered out with no error anywhere. The reasoning
         is spelled once, in milestone2's manifest. -->
    <queries>
        <package android:name="dev.kaya.cliphelper" />
    </queries>
    <application
        android:label="kaya milestone 0 (jvm ring)"
        android:theme="@style/Theme.Kaya">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- THE HARNESS'S EYES OUTSIDE THIS APP, declared here and not
             in the kaya library's manifest so a user's app never carries
             an accessibility service it did not ask for. Android's file
             picker is DocumentsUI, a separate APK, and this is what lets
             the scene read and drive it without moving the lane to
             instrumentation. The runner enables it over adb; it starts
             on its own never. -->
        <service
            android:name="dev.kaya.KayaHarnessAccessibility"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kaya_harness_accessibility" />
        </service>
    </application>
</manifest>
