<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The clipboard scene's foreign app: an explicit broadcast to a
         package this one cannot see is filtered out with no error
         anywhere (docs/traps.md: "An explicit broadcast to a package the
         sender cannot SEE is filtered out with no error"). -->
    <queries>
        <package android:name="dev.kaya.cliphelper" />
    </queries>
    <!-- The declared identity, read out of guests/assets/identity.toml
         by android/build.gradle.kts (rusthost's manifest carries the
         reasoning). -->
    <application
        android:icon="@mipmap/kaya_mark"
        android:label="${kayaAppLabel}"
        android:theme="@style/Theme.Kaya.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- THE HARNESS'S EYES OUTSIDE THIS APP (rusthost's manifest
             carries the reasoning). -->
        <service
            android:name="dev.kaya.KayaHarnessAccessibility"
            android:exported="false"
            android:label="kaya harness"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kaya_harness_accessibility" />
        </service>
    </application>
</manifest>
