<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The clipboard scene's foreign app: an explicit broadcast to a
         package this one cannot see is filtered out with no error
         anywhere (docs/traps.md: "An explicit broadcast to a package the
         sender cannot SEE is filtered out with no error"). -->
    <!-- LOCAL NOTIFICATIONS (docs/tasks-s3-plan.md N2, N3). Declared by
         the APP and not by the kaya library: POST_NOTIFICATIONS is the
         runtime prompt the first post asks for on API 33+ (the lane
         pre-grants it over adb), and USE_EXACT_ALARM is a claim about
         what this app IS — a reminders app qualifies, and a library may
         not make that claim for every app built on it. SCHEDULE_EXACT_ALARM
         is its pre-33 spelling, granted at install there. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <queries>
        <package android:name="dev.kaya.cliphelper" />
    </queries>
    <!-- The declared identity, read out of guests/assets/identity.toml
         by android/build.gradle.kts (rusthost's manifest carries the
         reasoning). -->
    <application
        android:icon="@mipmap/kaya_mark"
        android:label="${kayaAppLabel}"
        android:theme="@style/Theme.Kaya.Launch">
        <!-- APP LINKS (rusthost's manifest carries the reasoning):
             `singleTask` and the VIEW filter on the declared scheme. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${kayaLinkScheme}" />
            </intent-filter>
        </activity>
        <!-- THE HARNESS'S EYES OUTSIDE THIS APP (rusthost's manifest
             carries the reasoning). -->
        <service
            android:name="dev.kaya.KayaHarnessAccessibility"
            android:exported="false"
            android:label="kaya harness"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kaya_harness_accessibility" />
        </service>
    </application>
</manifest>
